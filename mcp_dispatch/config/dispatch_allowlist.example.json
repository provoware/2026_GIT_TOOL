{
  "schema_version": 1,
  "repositories": {
    "provoware/PROVOWARE_VIDEO_AUTOMATION_2026": {
      "workflows": {
        "kubuntu-pr-validation.yml": {
          "deny_unknown_inputs": true,
          "inputs": {
            "pr_number": {
              "required": true,
              "pattern": "^[1-9][0-9]{0,9}$",
              "max_length": 10
            },
            "base_sha": {
              "required": true,
              "pattern": "^[0-9a-f]{40}$",
              "min_length": 40,
              "max_length": 40
            },
            "head_sha": {
              "required": true,
              "pattern": "^[0-9a-f]{40}$",
              "min_length": 40,
              "max_length": 40
            },
            "head_ref": {
              "required": true,
              "pattern": "^[A-Za-z0-9._/-]{1,200}$",
              "max_length": 200
            },
            "report_issue": {
              "required": false,
              "pattern": "^[1-9][0-9]{0,9}$",
              "max_length": 10
            }
          }
        }
      }
    }
  }
}
