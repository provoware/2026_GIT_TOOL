{
  "$schemaVersion": 1,
  "meta": {
    "name": "Provoware Design Tokens",
    "description": "Single source of truth for UI colors, typography, spacing and responsive dimensions.",
    "defaultTheme": "acid-paper"
  },
  "themes": {
    "acid-paper": {
      "color": {
        "background": "#F2E8C9",
        "surface": "#FFF8DE",
        "surfaceElevated": "#FFFDF3",
        "text": "#17150F",
        "textMuted": "#5C5648",
        "border": "#2A261D",
        "accent": "#C7FF00",
        "accentText": "#101500",
        "success": "#2B8A3E",
        "warning": "#C56A00",
        "danger": "#B42318",
        "info": "#1261A0"
      }
    },
    "neon-scrap": {
      "color": {
        "background": "#0F1115",
        "surface": "#171A21",
        "surfaceElevated": "#20242D",
        "text": "#F5F7FA",
        "textMuted": "#B5BDC9",
        "border": "#5B6472",
        "accent": "#D8FF00",
        "accentText": "#111500",
        "success": "#46D369",
        "warning": "#FFB020",
        "danger": "#FF4D5E",
        "info": "#36A3FF"
      }
    }
  },
  "spacing": {"0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.5rem", "6": "2rem", "7": "3rem"},
  "radius": {"sm": "0.25rem", "md": "0.5rem", "lg": "0.75rem", "pill": "999px"},
  "typography": {
    "fontFamily": {"sans": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "mono": "'JetBrains Mono', 'Fira Code', monospace"},
    "fontSize": {"xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.25rem", "xl": "1.5rem", "2xl": "2rem"},
    "fontWeight": {"normal": 400, "medium": 500, "bold": 700},
    "lineHeight": {"tight": 1.2, "normal": 1.5}
  },
  "shadow": {"sm": "0 1px 2px rgba(0,0,0,.18)", "md": "0 6px 18px rgba(0,0,0,.22)"},
  "motion": {"fast": "120ms", "normal": "200ms", "slow": "320ms"},
  "zIndex": {"base": 0, "header": 100, "sidebar": 200, "dialog": 1000, "toast": 1100},
  "breakpoint": {"phone": "430px", "tablet": "768px", "desktop": "1200px"},
  "layout": {"contentMax": "1440px", "headerHeight": "4rem", "sidebarWidth": "17rem", "tileMin": "13rem", "touchTarget": "44px"}
}
