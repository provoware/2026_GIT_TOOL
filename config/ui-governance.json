  "non_goals": [
    "No GUI framework replacement.",
    "No visual production migration in block 1.",
    "No new cloud, synchronization or image-editing feature.",
    "No change to module activation, deactivation or close policy.",
    "No change to task execution, autosave, backup, logout or autostart contracts.",
    "No forced native iOS, iPadOS or Android claim for Tkinter.",
    "No generic table, preview or tooltip abstraction without demonstrated reuse.",
    "No decorative animation without a real application state."
  ],
  "acceptance_criteria": [
    {"id": "AC-001", "text": "Every current responsibility has exactly one owner."},
    {"id": "AC-002", "text": "config/design-tokens.json is the only hand-maintained design-token source."},
    {"id": "AC-003", "text": "All protected contracts and evidence files exist."},
    {"id": "AC-004", "text": "All duplication entries have a decision and target block."},
    {"id": "AC-005", "text": "Conditional shared components declare current consumers."},
    {"id": "AC-006", "text": "No forbidden parallel token source exists."},
    {"id": "AC-007", "text": "Block 1 changes no visual runtime implementation."},
    {"id": "AC-008", "text": "The design-token generator reports no drift."},
    {"id": "AC-009", "text": "Governance validation and unit tests pass in a read-only workflow."},
    {"id": "AC-010", "text": "The next permitted block is central token runtime mapping."}
  ],
  "migration_order": [
