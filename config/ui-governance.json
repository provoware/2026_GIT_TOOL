{
  "schema_version": 1,
  "phase": "ui-modernization",
  "current_block": 1,
  "title": "Globale UI-Governance und codesparsame Modernisierung",
  "principles": {
    "single_authoritative_owner": true,
    "tests_before_visual_migration": true,
    "preserve_hardened_contracts": true,
    "prefer_extension_over_parallel_implementation": true,
    "minimum_real_consumers_for_shared_component": 2,
    "single_consumer_exceptions": [
      "pure_logic_with_independent_tests",
      "security_or_lifecycle_boundary",
      "measurable_reduction_of_high_risk_window_complexity"
    ],
    "forbid_visual_runtime_migration_in_block_1": true,
    "forbid_parallel_token_sources": true
  },
  "authoritative_sources": [
    {
      "responsibility": "design_tokens",
      "owner": "config/design-tokens.json",
      "status": "authoritative"
    },
    {
      "responsibility": "design_token_generation",
      "owner": "system/generate_design_tokens.py",
      "status": "hardened"
    },
    {
      "responsibility": "tk_theme_resolution_and_application",
      "owner": "system/ui_theme_adapter.py",
      "status": "hardened"
    },
    {
      "responsibility": "responsive_rules",
      "owner": "system/ui_responsive.py",
      "status": "hardened"
    },
    {
      "responsibility": "automated_ui_acceptance",
      "owner": "system/ui_acceptance.py",
      "status": "hardened"
    },
    {
      "responsibility": "launcher_state_and_viewmodels",
      "owner": "system/launcher_controller.py",
      "status": "protected"
    },
    {
      "responsibility": "workspace_geometry",
      "owner": "system/workspace_geometry.py",
      "status": "protected"
    },
    {
      "responsibility": "module_card_lifecycle",
      "owner": "system/module_lifecycle.py",
      "status": "protected"
    },
    {
      "responsibility": "background_task_execution",
      "owner": "system/task_runner.py",
      "status": "protected"
    },
    {
      "responsibility": "autosave_backup_shutdown",
      "owner": "system/session_lifecycle.py",
      "status": "protected"
    },
    {
      "responsibility": "file_browser_sort_and_preview_model",
      "owner": "modules/datei_manager/browser.py",
      "status": "feature_local"
    },
    {
      "responsibility": "file_manager_window",
      "owner": "modules/datei_manager/window.py",
      "status": "feature_local"
    }
  ],
  "transitional_sources": [
    {
      "path": "config/launcher_gui.json",
      "duplicates": ["theme_colors", "spacing", "button_metrics", "typography"],
      "retain": ["refresh_debounce_ms", "theme_labels", "runtime_compatibility"],
      "target_block": 2
    },
    {
      "path": "config/datei_manager.json",
      "duplicates": ["theme_colors"],
      "retain": ["module_actions", "module_hints", "module_data_path"],
      "target_block": 2
    },
    {
      "path": "system/launcher_gui.py",
      "duplicates": ["button_configuration", "section_composition", "help_presentation"],
      "retain": ["launcher_view_composition", "framework_bindings"],
      "target_block": 3
    },
    {
      "path": "system/main_window.py",
      "duplicates": ["button_configuration", "hardcoded_spacing", "hardcoded_typography"],
      "retain": ["module_card_view", "workspace_bindings"],
      "target_block": 3
    },
    {
      "path": "modules/datei_manager/window.py",
      "duplicates": ["hardcoded_surface_colors", "hardcoded_window_metrics", "ttk_widget_styling"],
      "retain": ["file_manager_view", "treeview_and_preview_bindings"],
      "target_block": 7
    }
  ],
  "planned_responsibilities": [
    {
      "responsibility": "python_design_token_artifact",
      "target": "generated/design-tokens.py",
      "target_block": 2,
      "condition": "always",
      "note": "Deterministisch aus config/design-tokens.json erzeugen; kein handgepflegtes ui_tokens.py."
    },
    {
      "responsibility": "shared_tk_components",
      "target": "system/ui_components.py",
      "target_block": 3,
      "condition": "at_least_two_real_consumers",
      "current_consumers": ["system/launcher_gui.py", "system/main_window.py", "modules/datei_manager/window.py"]
    },
    {
      "responsibility": "shared_table_policy",
      "target": "system/ui_tables.py",
      "target_block": 4,
      "condition": "second_real_treeview_consumer_exists",
      "current_consumers": ["modules/datei_manager/window.py"]
    },
    {
      "responsibility": "shared_preview_policy",
      "target": "system/ui_preview.py",
      "target_block": 5,
      "condition": "second_real_preview_consumer_exists",
      "current_consumers": ["modules/datei_manager/window.py"]
    },
    {
      "responsibility": "shared_accessibility_helpers",
      "target": "system/ui_accessibility.py",
      "target_block": 3,
      "condition": "duplicated_cross_surface_behavior_is_demonstrated",
      "current_consumers": ["system/launcher_gui.py", "system/main_window.py", "modules/datei_manager/window.py"]
    }
  ],
  "forbidden_parallel_sources": [
    "system/ui_tokens.py",
    "config/ui-tokens.json",
    "config/design_tokens_runtime.json",
    "modules/datei_manager/ui_tokens.py"
  ],
  "protected_contracts": [
    {
      "path": "system/launcher_reports.py",
      "evidence": ["tests/test_launcher_reports.py"]
    },
    {
      "path": "system/workspace_geometry.py",
      "evidence": ["tests/test_workspace_geometry.py"]
    },
    {
      "path": "system/ui_theme_adapter.py",
      "evidence": ["tests/test_ui_theme_adapter.py"]
    },
    {
      "path": "system/task_runner.py",
      "evidence": ["tests/test_task_runner.py"]
    },
    {
      "path": "system/session_lifecycle.py",
      "evidence": ["tests/test_session_lifecycle.py", "tests/test_gate5_safe_mode.py"]
    },
    {
      "path": "system/autostart_manager.py",
      "evidence": ["tests/test_autostart_manager.py"]
    },
    {
      "path": "system/module_lifecycle.py",
      "evidence": ["tests/test_module_lifecycle.py"]
    },
    {
      "path": "system/launcher_controller.py",
      "evidence": ["tests/test_launcher_controller.py"]
    },
    {
      "path": "system/ui_responsive.py",
      "evidence": ["tests/test_ui_responsive.py"]
    },
    {
      "path": "system/ui_acceptance.py",
      "evidence": ["tests/test_ui_acceptance.py", "tests/test_ui_acceptance_report.py"]
    },
    {
      "path": "modules/datei_manager/browser.py",
      "evidence": ["tests/test_datei_manager_browser.py"]
    },
    {
      "path": "modules/datei_manager/window.py",
      "evidence": ["tests/test_datei_manager_window.py", "tests/test_datei_manager_entry.py"]
    }
  ],
