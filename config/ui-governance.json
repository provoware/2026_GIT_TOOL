      "decision": "map_generated_tokens_to_tk_metrics_then_remove_hardcoded_values",
      "target_block": 2
    },
    {
      "id": "DUP-003",
      "topic": "typography",
      "severity": "high",
      "locations": ["config/design-tokens.json", "system/launcher_gui.py", "system/main_window.py", "modules/datei_manager/window.py"],
      "decision": "introduce_generated_tk_typography_mapping",
      "target_block": 2
    },
    {
      "id": "DUP-004",
