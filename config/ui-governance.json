  "non_goals": [
    "No GUI framework replacement.",
    "No broad screen redesign outside shared component roles in block 3.",
    "No file-manager visual migration in block 3.",
    "No change to module activation, deactivation or close policy.",
    "No change to task execution, autosave, backup, logout or autostart contracts.",
    "No forced native iOS, iPadOS or Android claim for Tkinter.",
    "No generic table, preview or tooltip abstraction without demonstrated reuse.",
    "No decorative animation without a real application state."
  ],
  "acceptance_criteria": [
    {
      "id": "AC-001",
      "text": "config/design-tokens.json remains the only hand-maintained design-token source."
    },
    {
      "id": "AC-002",
      "text": "system/ui_components.py is the only owner of shared Tk component roles, metrics and visual states."
    },
    {
      "id": "AC-003",
      "text": "Primary, secondary, neutral and danger buttons expose distinct normal, hover, active, focus and disabled states."
    },
    {
      "id": "AC-004",
      "text": "Event bindings are idempotent and disabled widgets cannot enter hover or active visuals."
    },
    {
      "id": "AC-005",
      "text": "Launcher and main-window widgets consume roles through the existing theme adapter."
    },
    {
      "id": "AC-006",
      "text": "Launcher status text, cursor and controller state remain authoritative while only visual status styling is shared."
    },
    {
      "id": "AC-007",
      "text": "Module lifecycle, close policy, workspace geometry and task execution contracts remain unchanged."
    },
    {
      "id": "AC-008",
      "text": "Component, theme, codemod and governance tests pass in read-only workflows."
    },
    {
      "id": "AC-009",
      "text": "Automated Xvfb UI acceptance and relevant regression gates remain green."
    },
    {
      "id": "AC-010",
      "text": "The next permitted block is the conditional shared table policy decision."
    }
  ],
